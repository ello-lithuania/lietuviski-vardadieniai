    <version>__VERSION__</version>
    <title>Vardadieniai (Lithuanian name days)</title>
    <authors>KokybiskaSvetaine.lt</authors>
    <owners>ello-lithuania</owners>
    <projectUrl>https://dovanasuvardu.lt/vardadieniai/</projectUrl>
    <projectSourceUrl>https://github.com/ello-lithuania/lietuviski-vardadieniai</projectSourceUrl>
    <packageSourceUrl>https://github.com/ello-lithuania/lietuviski-vardadieniai/tree/main/packaging/chocolatey/vardadieniai</packageSourceUrl>
    <docsUrl>https://github.com/ello-lithuania/lietuviski-vardadieniai#readme</docsUrl>
